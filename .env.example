# =====================================================================
# Cybersec Academy — environment configuration TEMPLATE
# Copy to `.env` (which is git-ignored) and fill in real values locally.
# NEVER commit real secrets. NEVER put SERVICE/privileged values in any
# variable that starts with NEXT_PUBLIC_ (those are shipped to browsers).
# =====================================================================

# ---------- Backend (FastAPI) — server-side only ----------
# "local"    -> backend issues its own JWTs (development without Supabase)
# "supabase" -> frontend signs in with Supabase Auth; backend only verifies tokens
AUTH_MODE=local

# Postgres connection used by the backend. Locally this is your own Postgres.
# On Supabase use the *pooler* connection string (transaction mode, port 6543).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cybersec_academy

# Used only when AUTH_MODE=local. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LOCAL_JWT_SECRET=change-me-to-a-long-random-value

# Used only when AUTH_MODE=supabase (find it in Supabase > Project Settings > API)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ---------- Frontend (Next.js) — these ARE public ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
